# Optional hosted-development browser configuration.
# Copy this file to .env.hosted.local, then use `npm run dev:hosted` deliberately.
# Normal `npm run dev` ignores these values and uses local Supabase.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Older Supabase projects may use an anon key instead of a publishable key.
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
