{
  "name": "fanatical-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:hosted": "vite --mode hosted",
    "backend:start": "node scripts/local-supabase.mjs start",
    "backend:stop": "node scripts/local-supabase.mjs stop",
    "backend:reset": "node scripts/local-supabase.mjs reset",
    "backend:status": "node scripts/local-supabase.mjs status",
    "backend:test": "node scripts/local-supabase.mjs test",
    "backend:verify": "node scripts/verify-local-supabase.mjs",
    "backend:types": "node scripts/generate-supabase-types.mjs",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --mode admin",
    "deploy:web": "wrangler deploy --config wrangler.web.jsonc",
    "deploy:admin": "wrangler deploy --config wrangler.admin.jsonc",
    "preview": "vite preview",
    "preview:admin": "vite preview --mode admin",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --config playwright.admin.config.ts",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "supabase": "2.115.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "4.124.0"
  }
}
